# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# ── Supabase ──────────────────────────────────────────────────
# Encontre em: https://supabase.com/dashboard → projeto → Settings → API

# URL do projeto (ex: https://xyzxyz.supabase.co)
SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave anon/public — usada no browser via Vite
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SEU_ANON_KEY

# Service Role Key — SOMENTE no servidor, NUNCA expor no browser
SUPABASE_SERVICE_ROLE_KEY=SEU_SERVICE_ROLE_KEY
