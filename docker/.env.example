# ================================================================
# SIS-PDV — Variáveis de Ambiente (Multi-Cliente)
# Copie este arquivo: cp .env.example .env
# Preencha os valores e NUNCA commite o .env no Git
# ================================================================

# Chave Google Gemini — compartilhada entre todos os clientes
GEMINI_API_KEY=sua_chave_gemini_aqui

# ─── CLIENTE 1 ──────────────────────────────────────────────
# Senha do banco PostgreSQL local (crie uma senha forte)
CLIENTE1_DB_PASS=senha_forte_cliente_1

# Supabase deste cliente (usado APENAS para Auth — login do dono)
# Crie um projeto gratuito em https://supabase.com para cada cliente
CLIENTE1_SUPABASE_URL=https://xxxxxxxxxxxxxx.supabase.co
CLIENTE1_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
CLIENTE1_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── CLIENTE 2 ──────────────────────────────────────────────
CLIENTE2_DB_PASS=senha_forte_cliente_2
CLIENTE2_SUPABASE_URL=https://yyyyyyyyyyyyyy.supabase.co
CLIENTE2_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
CLIENTE2_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

