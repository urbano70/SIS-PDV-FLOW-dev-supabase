rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && request.auth.token.email == 'urbano70@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidOrder(data) {
      // Basic check for required fields and types
      return data.size() >= 4 && 
             data.tableId is int && 
             data.items is list && 
             data.status in ['pending', 'preparing', 'ready', 'finalizada'] &&
             data.timestamp is string;
    }

    function isValidTable(data) {
      return data.size() >= 2 && 
             (data.id is int || data.id is string) && 
             data.status in ['free', 'occupied', 'bill_requested', 'linked'];
    }

    // --- Collections ---

    match /tables/{tableId} {
      allow read: if isVerified();
      allow update: if isAdmin() || (isVerified() && isValidTable(incoming()));
    }

    match /comandas/{comandaId} {
      allow read: if isVerified();
      allow update: if isAdmin() || (isVerified() && isValidTable(incoming()));
    }

    match /orders/{orderId} {
      allow read: if isVerified();
      
      // Allow list queries but force secure filtering on the app side
      allow list: if isVerified();
      
      allow create: if isVerified() && isValidOrder(incoming());
      
      allow update: if isVerified() && (
        isAdmin() || (
          // Partial updates for waiters - only allowed fields
          incoming().diff(existing()).affectedKeys().hasOnly(['items', 'status', 'observations', 'partialPayments', 'paymentLog', 'discount', 'discountType']) &&
          existing().status != 'finalizada' // Terminal state lock
        )
      );
    }

    match /waiters/{waiterId} {
      allow read: if isVerified();
      // Allow registration, but only for the user's own profile and if it doesn't exist
      allow create: if isVerified() && waiterId == request.auth.uid && !exists(/databases/$(database)/documents/waiters/$(request.auth.uid));
      allow update: if isAdmin();
    }

    match /stock/{itemId} {
      allow read: if isVerified();
      allow write: if isAdmin();
    }

    match /menu/{categoryId} {
      allow read: if isVerified();
      allow write: if isAdmin();
    }

    match /config/{configId} {
      allow read: if isVerified();
      allow write: if isAdmin();
    }
  }
}
